rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    // Staff login lewat custom token dari Worker: klaim `staff`, `role`, `divisi` diisi
    // Worker berdasarkan profil Portal. Sesi anonim (chat.html, supplier-view.html) tidak punya klaim ini.
    function isStaffAuth() { return isAuth() && request.auth.token.get('staff', false) == true; }
    function role() { return request.auth.token.get('role', ''); }
    function isOwner() { return isStaffAuth() && role() == 'owner'; }
    function isOwnerOrCS() { return isStaffAuth() && role() in ['owner','cs']; }
    function isData() { return isStaffAuth() && role() == 'data'; }
    function isDivisiOwner() { return isStaffAuth() && role() == 'divisi'; }
    function userDivisi() { return request.auth.token.get('divisi', ''); }
    function isDivisiOwnerOf(div) { return isDivisiOwner() && userDivisi() == div; }
    // Pemilik Divisi (role 'divisi') hanya boleh menyentuh order divisinya sendiri;
    // role lain tidak terpengaruh. Query order Pemilik Divisi wajib where('division', '==', divisinya).
    function bolehOrderData(d) { return !isDivisiOwner() || d.get('division', '') == userDivisi(); }
    function bolehOrderId(orderId) {
      return !isDivisiOwner()
        || get(/databases/$(database)/documents/orders/$(orderId)).data.get('division', '') == userDivisi();
    }
    // ── Approval harga order ──
    // Promo disetujui Kepala Cabang (manager) / Owner; Admin hanya Owner. Staf lain hanya boleh
    // menurunkan status ke 'pending' (minta approval), tidak bisa menyetujui sendiri.
    function kunciApproval() { return ['priceApprovalStatus', 'priceApprovalBy', 'priceApprovalByName', 'priceApprovalAt', 'priceApprovalTier']; }
    function bolehSetujuiTier(t) { return isOwner() || (isStaffAuth() && role() == 'manager' && t == 'promo'); }
    function approvalSahBaru(d) {
      return d.get('priceApprovalStatus', 'approved') != 'approved'
        || d.get('priceApprovalTier', null) == null
        || (bolehSetujuiTier(d.get('priceApprovalTier', null)) && d.get('priceApprovalBy', '') == request.auth.uid);
    }
    function approvalSahUbah() {
      let n = request.resource.data;
      let o = resource.data;
      let ubahApproval = n.diff(o).affectedKeys().hasAny(kunciApproval());
      let ubahStatus = n.get('status', '') != o.get('status', '');
      let menunggu = o.get('priceApprovalStatus', '') == 'pending' || n.get('priceApprovalStatus', '') == 'pending';
      let tierLama = o.get('priceApprovalTier', null);
      let tierBaru = n.get('priceApprovalTier', tierLama);
      return (!ubahApproval
          || (bolehSetujuiTier(tierBaru) && (tierLama == null || tierLama == 'normal' || bolehSetujuiTier(tierLama)))
          || (n.get('priceApprovalStatus', '') == 'pending' && n.get('priceApprovalBy', null) == null))
        // Order yang menunggu approval harga belum boleh masuk produksi
        && (!ubahStatus || !menunggu
          || n.get('status', '') in ['pending-approval', 'cancelled', 'draft']
          || (bolehSetujuiTier(tierBaru) && (tierLama == null || tierLama == 'normal' || bolehSetujuiTier(tierLama))));
    }
    // Kolom yang hanya boleh diatur owner (users.html)
    function kolomOwner() { return ['lokasiId', 'lokasiNama', 'lokasiTipe', 'pin', 'divisions']; }

    match /users/{uid} {
      allow read: if isStaffAuth();
      // Staff boleh menyalin nama/email ke dokumennya sendiri; role harus sama dengan klaim token
      allow create: if isOwner() || (isStaffAuth() && request.auth.uid == uid
        && request.resource.data.get('role', '') == role()
        && !request.resource.data.keys().hasAny(kolomOwner()));
      allow update: if isOwner() || (isStaffAuth() && request.auth.uid == uid
        && request.resource.data.get('role', '') == role()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(kolomOwner()));
      allow delete: if isOwner();
    }
    match /orders/{orderId} {
      // Customer (chat.html) & supplier (supplier-view.html) memakai sesi anonim dan
      // hanya membuka satu order lewat ID; daftar semua order khusus staff.
      allow get: if isAuth() && bolehOrderData(resource.data);
      allow list: if isStaffAuth() && bolehOrderData(resource.data);
      allow create: if isStaffAuth() && bolehOrderData(request.resource.data) && approvalSahBaru(request.resource.data);
      // Sesi anonim hanya boleh menyentuh penghitung chat & persentase progress
      // Tanda "sudah dicek di mutasi rekening" & "upah penjahit sudah ditransfer" hanya boleh diubah Owner
      allow update: if bolehOrderData(resource.data) && bolehOrderData(request.resource.data) && ((isStaffAuth()
          && approvalSahUbah()
          && (isOwner() || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['paymentVerifiedAt', 'paymentVerifiedBy', 'paymentVerifiedAmount',
                       'tailorPayments', 'tailorPaid', 'tailorPaidBy', 'tailorPaidAt'])))
        || (isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['unreadCustomerChat', 'lastCustomerMsgAt', 'unreadSupplierChat', 'progressPercentage', 'updatedAt'])));
      allow delete: if isOwner();
    }
    match /orders/{orderId}/progress_updates/{id} {
      allow read: if isAuth() && bolehOrderId(orderId);
      allow create: if isAuth() && bolehOrderId(orderId);
      allow update: if isStaffAuth() && bolehOrderId(orderId); // edit progress (note/percentage)
      allow delete: if isStaffAuth() && bolehOrderId(orderId); // owner/manager/cs/divisi bisa hapus
    }
    match /orders/{orderId}/internal_chat/{msgId} {
      allow read: if isStaffAuth() && bolehOrderId(orderId);
      allow create: if isStaffAuth() && bolehOrderId(orderId);
      allow delete: if isOwner();
    }
    match /orders/{orderId}/supplier_chat/{msgId} {
      allow read, create, update, delete: if isAuth() && bolehOrderId(orderId);
    }
    // Per-supplier chat (order baru dengan 1+ supplier terpisah)
    match /orders/{orderId}/supplier_chats/{supplierId}/messages/{msgId} {
      // supplier akses via anonymous auth + token
      allow read, create, update, delete: if isAuth() && bolehOrderId(orderId);
    }
    match /product_knowledge/{id} {
      allow read: if true; // Public — customer can read
      allow write: if isOwner() || isData() || isDivisiOwnerOf(id);
    }
    match /order_counters/{div} {
      allow read, write: if isStaffAuth();
    }
    // Daftar harga lengkap (harga modal/promo/admin) — hanya staf.
    // Hanya Owner yang menulis langsung. Staf lain (CS: Normal/Cabang yang kosong & item baru,
    // Kepala Cabang: + Promo, Data/Pemilik Divisi: + Modal) menyimpan lewat Worker /price-list-save
    // yang memeriksa kolom per role — Harga Admin hanya bisa diisi Owner.
    match /price_list/{div} {
      allow read: if isStaffAuth();
      allow write: if isOwner();
    }
    // Salinan untuk customer (chat.html): hanya harga jual — ditulis Owner / Worker
    match /price_list_public/{div} {
      allow read: if isAuth();
      allow write: if isOwner();
    }
    // Daftar penjahit + rekening (dipilih di order Jersey/Tailor). Penjahit baru boleh ditambah
    // Owner/CS/Produksi beserta rekeningnya; rekening yang sudah tersimpan hanya boleh diubah Owner
    // (mencegah rekening penjahit diganti ke rekening lain).
    match /penjahit/{id} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow create: if isStaffAuth() && role() in ['owner', 'cs', 'production']
        && request.resource.data.nama is string && request.resource.data.nama.size() > 0;
      allow update: if isOwner()
        || (isStaffAuth() && role() in ['cs', 'production']
            && resource.data.get('noRek', '') == ''
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['bank', 'noRek', 'atasNama', 'updatedAt', 'updatedBy']));
      allow delete: if isOwner();
    }
    // Pengajuan upah penjahit (kumpulan beberapa order) — CS/produksi mengajukan, Owner menandai dibayar
    // Yang boleh mengajukan upah: Owner, tim produksi divisi itu, atau CS yang merangkap produksi divisi itu
    // (klaim divs/rangkap dari Worker). Divisi pengajuan = divisi order-order di dalamnya.
    function bolehAjukanUpah(divs) {
      let punya = request.auth.token.get('divs', []);
      return role() == 'owner'
        || (role() == 'production' && (punya.size() == 0 || punya.hasAll(divs)))
        || (role() == 'cs' && request.auth.token.get('rangkap', false) == true && punya.size() > 0 && punya.hasAll(divs));
    }
    match /pengajuan_upah/{id} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow create: if isStaffAuth() && role() in ['owner', 'cs', 'production']
        && request.resource.data.status == 'diajukan'
        && request.resource.data.dibuatOlehUid == request.auth.uid
        && request.resource.data.divisions is list && request.resource.data.divisions.size() > 0
        && bolehAjukanUpah(request.resource.data.divisions);
      allow update: if isOwner()
        || (isStaffAuth() && resource.data.dibuatOlehUid == request.auth.uid
            && resource.data.status == 'diajukan' && request.resource.data.status == 'batal'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'batalOleh', 'batalAt']))
        // Staf yang mengajukan mencatat bahwa pengajuan sudah dikirim ke Adi lewat WhatsApp
        || (isStaffAuth() && resource.data.dibuatOlehUid == request.auth.uid
            && resource.data.status == 'diajukan' && request.resource.data.status == 'diajukan'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waDikirimAt', 'waDikirimOleh', 'waDikirimKali']));
      allow delete: if isOwner();
    }
    // Riwayat pembayaran order (satu dokumen per pembayaran masuk) — dicatat CS/Owner saat DP/pelunasan,
    // tidak bisa diubah/dihapus selain Owner supaya jejak uang masuk tetap utuh
    match /pembayaran/{id} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow create: if isOwnerOrCS()
        && request.resource.data.olehUid == request.auth.uid
        && request.resource.data.jumlah is number
        && request.resource.data.tgl is string
        && request.resource.data.orderId is string
        && !request.resource.data.keys().hasAny(['dicekAt', 'dicekOleh']);
      allow update, delete: if isOwner();
    }
    // ── Kas Cabang: tutup kasir harian & kas keluar/masuk per lokasi ──
    // Penerima/penyetuju: Owner, Kepala Cabang (manager) lokasi itu, atau pemilik cabang (Pemilik Divisi pemilik lokasi).
    function lokasiData(id) { return get(/databases/$(database)/documents/lokasi/$(id)).data; }
    function lokasiSaya() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lokasiId', ''); }
    function penerimaCabang(lokId) {
      return isOwner()
        || (isStaffAuth() && role() == 'manager' && lokasiSaya() == lokId)
        || (isDivisiOwner() && lokasiData(lokId).get('divisiPemilik', '') == userDivisi());
    }
    function bacaCabang(lokId) { return (isStaffAuth() && !isDivisiOwner()) || penerimaCabang(lokId); }
    function kunciTerima() { return ['status', 'diterimaNama', 'diterimaUid', 'diterimaAt', 'catatanKembali']; }
    match /tutup_kasir_cabang/{id} {
      allow read: if bacaCabang(resource.data.lokasiId);
      allow create: if isStaffAuth() && role() in ['owner', 'manager', 'cs']
        && request.resource.data.status == 'menunggu' && id == request.resource.data.lokasiId + '_' + request.resource.data.tgl;
      // Penginput boleh mengubah selama belum diterima (status kembali 'menunggu'); penerima memutuskan
      allow update: if isOwner()
        || (isStaffAuth() && role() in ['manager', 'cs'] && resource.data.status in ['menunggu', 'dikembalikan']
            && request.resource.data.status == 'menunggu' && request.resource.data.lokasiId == resource.data.lokasiId)
        || (penerimaCabang(resource.data.lokasiId) && resource.data.status == 'menunggu'
            && request.resource.data.status in ['diterima', 'dikembalikan']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(kunciTerima()));
      allow delete: if isOwner();
    }
    function batasKas() {
      let p = /databases/$(database)/documents/settings/kas_cabang;
      return exists(p) ? get(p).data.get('batasApproval', 500000) : 500000;
    }
    function kunciSetuju() { return ['status', 'disetujuiNama', 'disetujuiUid', 'disetujuiAt']; }
    match /kas_cabang/{id} {
      allow read: if bacaCabang(resource.data.lokasiId);
      allow create: if isStaffAuth() && role() in ['owner', 'manager', 'cs']
        && request.resource.data.olehUid == request.auth.uid && request.resource.data.jumlah is number
        && (request.resource.data.status == 'menunggu' || (request.resource.data.status == 'ok'
            && (request.resource.data.jenis == 'masuk' || request.resource.data.jumlah < batasKas()
                || penerimaCabang(request.resource.data.lokasiId))));
      allow update: if isOwner()
        || (penerimaCabang(resource.data.lokasiId) && resource.data.status == 'menunggu'
            && request.resource.data.status in ['ok', 'ditolak'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(kunciSetuju()));
      allow delete: if isOwner() || (isStaffAuth() && resource.data.olehUid == request.auth.uid && resource.data.status == 'menunggu');
    }
    // Catatan follow up order ulang per customer (id = nomor WA) — staf non pemilik divisi
    match /customer_followup/{id} {
      allow read, write: if isStaffAuth() && !isDivisiOwner();
    }
    // Transfer modal antar pemilik (Kewajiban Antar Pemilik) — hanya Owner
    match /setoran_pemilik/{id} {
      allow read, write: if isOwner();
    }
    // Laporan harian uang masuk custom order per lokasi ({lokasi}_{tgl}); tanda "sudah dicek" hanya Owner,
    // setelah dicek laporan terkunci untuk selain Owner
    match /laporan_harian/{id} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow create: if isStaffAuth() && role() in ['owner', 'manager', 'cs']
        && request.resource.data.dibuatOlehUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['dicekAt', 'dicekOleh', 'dicekUid']);
      allow update: if isOwner()
        || (isStaffAuth() && role() in ['manager', 'cs']
            && resource.data.get('dicekAt', null) == null
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dicekAt', 'dicekOleh', 'dicekUid']));
      allow delete: if isOwner();
    }
    // Upah jahit per pcs (internal, Jersey/Tailor) — dibaca staf untuk hitung upah otomatis, diatur Owner/Data
    match /upah_jahit/{div} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow write: if isOwner() || isData();
    }
    match /settings/{id} {
      allow read: if isStaffAuth();
      allow write: if isOwner();   // rekening bank, QRIS, target omzet — hanya owner
    }

    // Badge @mention per user
    match /user_mentions/{uid} {
      allow read: if isStaffAuth() && request.auth.uid == uid;
      allow write: if isStaffAuth();
    }

    // Public order info for customer chat (token-based access)
    match /public_order_info/{chatToken} {
      allow read: if true;
      allow write: if isStaffAuth();
    }

    match /lokasi/{id} {
      allow read: if isStaffAuth();
      allow write: if isOwner();
    }

    match /divisions/{id} {
      allow read: if isAuth(); // Public read so chat.html can filter inactive divisions
      allow write: if isOwner();
    }

    match /suppliers/{id} {
      allow read: if isStaffAuth();
      allow write: if isOwner();
    }

    match /supplier_tokens/{token} {
      allow read: if true; // Supplier akses via token tanpa login
      allow write: if isStaffAuth();
    }

    // Chat messages — public read/write (token = password)
    match /chat_messages/{chatToken}/messages/{msgId} {
      allow read: if true;
      allow create: if true; // Anyone with token can send
      allow delete: if isOwner();
    }

    // Chat inbox threads — readable by all staff, writable by owner/cs
    match /chat_threads/{threadId} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow write: if isOwnerOrCS();
    }
    match /chat_threads/{threadId}/messages/{msgId} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow create: if isStaffAuth() && !isDivisiOwner();
      allow delete: if isOwner();
    }

    // WA number mapping — HANYA backend (Cloudflare Worker) yang boleh akses
    // Firestore Rules memblokir semua client — Worker pakai service account yang bypass rules
    match /chat_wa_numbers/{waNumber} {
      allow read, write: if false;
    }

    // Chat thread counter — backend only
    match /chat_counters/{id} {
      allow read, write: if false;
    }

    // In-app notifications per order internal chat
    match /notifications/{notifId} {
      // Pemilik Divisi: hanya notifikasi divisinya + mention untuk dirinya
      allow read: if isStaffAuth() && (!isDivisiOwner()
        || resource.data.get('division', '') == userDivisi()
        || resource.data.get('targetUid', '') == request.auth.uid);
      allow create: if isStaffAuth();
      allow delete: if isOwner();
    }

    // Konsultasi pra-order (sebelum ada order) — dibuat oleh WA Bot via service account
    match /consultations/{token} {
      allow read: if true;   // public — customer akses via token
      allow write: if false; // hanya backend (service account bypass rules)
    }

    // Flag pesan mencurigakan — staff menulis, owner yang baca & tinjau
    match /chat_flags/{id} {
      allow read: if isOwner();
      allow create: if isStaffAuth();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // Bot session state per WA number — hanya Worker (service account bypass rules)
    match /chat_sessions/{waNumber} {
      allow read, write: if false;
    }

    // Customer feedback — public write (token = password), staff read only
    match /feedback/{token} {
      allow read: if isStaffAuth() && !isDivisiOwner();
      allow create: if true; // Anyone with token can submit feedback
      allow update: if false; // No editing after submit
      allow delete: if isOwner();
    }
  }
}
