rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() { return request.auth != null && request.auth.token.get('staff', false) == true; }
    function gambarAtauPdf() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp','image/gif','application/pdf'];
    }

    // Staff (login via Portal) bisa akses semua
    match /{allPaths=**} {
      allow read, write: if isStaff();
    }
    // Customer chat — boleh upload foto tanpa login, max 10MB, hanya gambar & PDF
    match /chats/{allPaths=**} {
      allow read: if true;
      allow write: if gambarAtauPdf();
    }
    // Supplier (supplier-view.html, sesi anonim) — foto progress & chat vendor
    match /supplier_progress/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && gambarAtauPdf();
    }
    match /supplier_chat/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && gambarAtauPdf();
    }
  }
}
